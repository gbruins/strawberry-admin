# Strawberry Server API
VITE_API_BASE_URL=http://localhost:10000/api/v1/

# Supabase project — used client-side for login/signup/password-reset (specs/004-multi-tenant-supabase)
# Both of these are bundled into the client (anything in VITE_* is public); the anon key is
# meant to be public and relies on Supabase's own Row-Level Security, not secrecy.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=
